# PostgreSQL Database
POSTGRES_URL=your_postgres_url_here

# Google Sheets Service Account
GOOGLE_SERVICE_EMAIL=your_service_email@project.iam.gserviceaccount.com
GOOGLE_SERVICE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Server Port
PORT=3000

# Stripe API Keys
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google Sheets Document ID
GOOGLE_SHEETS_DOC_ID=your_google_sheets_doc_id_here

# For two separate tables (future use)
GOOGLE_SHEETS_FIRST_PURCHASES_DOC_ID=your_first_purchases_sheet_id_here
GOOGLE_SHEETS_TRIAL_UPGRADES_DOC_ID=your_trial_upgrades_sheet_id_here

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Slack (optional)
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL_ID=your_slack_channel_id_here

# Security (strongly recommended)
# ADMIN_API_KEY: when set, all admin /api endpoints require header x-api-key.
#   When EMPTY, those endpoints are open (no auth) — set this in production.
ADMIN_API_KEY=
# PRIMER_WEBHOOK_SECRET: when set, Primer webhook signatures are verified
#   (missing/invalid signature -> 401). When EMPTY, signatures are NOT checked.
PRIMER_WEBHOOK_SECRET=

# Primer API (PayPal payments)
PRIMER_API_KEY=your_primer_api_key_here
PRIMER_API_URL=https://api.primer.io
PRIMER_API_VERSION=2.3
PRIMER_SHEET_NAME=Primer

# Bot Settings
BOT_DISABLED=false
NOTIFICATIONS_DISABLED=false
AUTO_SYNC_DISABLED=false
